# 飞书 / Lark 应用凭证
# 在 https://open.feishu.cn/app (国内) 或 https://open.larksuite.com/app (海外) 创建企业自建应用后获取
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 事件订阅的 Verification Token 和 Encrypt Key
# 在应用的 "事件订阅" 页面获取。Encrypt Key 可选（留空则不解密），但强烈建议开启。
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 域名选择：feishu (国内 open.feishu.cn) 或 lark (海外 open.larksuite.com)
FEISHU_DOMAIN=feishu

# kagent A2A 入口 URL
# 例如：http://localhost:8080/a2a/default/my-agent (本地调试)
# 或：https://kagent.example.com/a2a/default/my-agent (生产环境)
KAGENT_A2A_URL=

# 服务监听端口
PORT=9000